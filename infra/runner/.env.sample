# Copy to .env next to docker-compose.yml on the host. NEVER commit .env.

# Resolve the current release before provisioning and pin it:
# https://hub.docker.com/r/myoung34/github-runner/tags
RUNNER_IMAGE_TAG=***PIN_EXACT_VERSION***

# lipas-prod-1 on lipas-prod, lipas-dev-1 on lipas-dev
RUNNER_NAME=***FILL_THIS***

# The runs-on label deploy workflows target: lipas-prod or lipas-dev
RUNNER_LABELS=***FILL_THIS***

# One-time registration token from
# repo → Settings → Actions → Runners → New self-hosted runner.
# Expires in ~1h; only needed for the FIRST boot. May be blanked afterwards —
# the registration persists in the runner-state volume.
RUNNER_TOKEN=

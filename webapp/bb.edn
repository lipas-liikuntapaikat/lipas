{:tasks {:requires ([clojure.string :as str]
                    [clojure.edn :as edn]
                    [clojure.java.io :as io]
                    [babashka.process :as process])

         ;; === DEPLOYMENT CONFIGURATION ===
         :init (do
                 (def deploy-config
                   {:paths {:backend-jar           "target/backend.jar"
                            :frontend-manifest     "resources/public/js/compiled/manifest.edn"
                            :frontend-compiled-dir "resources/public/js/compiled"}
                    :hosts {:dev "lipas-dev"
                            :prod "lipas-prod"}
                    :urls {:dev "https://lipas-dev.cc.jyu.fi"
                           :prod "https://lipas.fi"}})

                 ;; === LINT & FORMAT ===
                 ;;
                 ;; clj-kondo and cljfmt both discover their config by walking
                 ;; UP from the process working directory, and this project's
                 ;; config lives here in webapp/ (.clj-kondo/, .cljfmt.edn)
                 ;; rather than at the repository root. Invoked from the root
                 ;; they silently fall back to tool defaults — for cljfmt that
                 ;; is :community indentation instead of this project's
                 ;; :cursive, which is how 183 files drifted out of format
                 ;; before this was gated. Every task below pins the working
                 ;; directory to this bb.edn's directory, so the verdict never
                 ;; depends on where the task was invoked from.

                 (def project-dir
                   (str (.getParent (io/file (System/getProperty "babashka.config")))))

                 (def lint-paths
                   "Everything that must stay lint- and format-clean."
                   ["src" "test" "dev" "build.clj" "scripts"])

                 ;; bb.edn is EDN, so regex literals are not allowed here.
                 ;; Extensions match what cljfmt already picks up when it is
                 ;; handed a directory — .edn included, since src/ holds 239 of
                 ;; them (i18n, data mappings) and they are part of the format.
                 (def clj-source-re (re-pattern "\\.(clj[scdx]?|bb|edn)$"))
                 (def webapp-prefix-re (re-pattern "^webapp/"))

                 (defn clj-source? [p]
                   (boolean (re-find clj-source-re (str p))))

                 (defn keepable?
                   "A path is worth passing to the tools if it exists and is
                    either a directory (both tools recurse into one) or a
                    Clojure source file."
                   [p]
                   (let [f (io/file project-dir p)]
                     (and (.exists f)
                          (or (.isDirectory f) (clj-source? p)))))

                 (defn resolve-paths
                   "Turn task arguments into webapp-relative paths. With no
                    arguments, falls back to lint-paths. Accepts both `src/…`
                    and repo-root-relative `webapp/src/…`, so piping
                    `git diff --name-only` straight in works.

                    Returns {:paths [...] :dropped [...]}. Callers must treat
                    'arguments given but nothing resolved' as a failure, never
                    as success: silently reporting \"nothing to do\" and exiting
                    0 turns a typo'd path — or a directory, which an earlier
                    version rejected outright — into a green gate that checked
                    nothing at all."
                   [args]
                   (if (empty? args)
                     {:paths lint-paths :dropped []}
                     (let [norm    (map (fn [p] (str/replace (str p) webapp-prefix-re "")) args)
                           grouped (group-by keepable? norm)]
                       {:paths   (vec (distinct (get grouped true)))
                        :dropped (vec (distinct (get grouped false)))})))

                 (defn report-dropped [dropped]
                   (when (seq dropped)
                     (println "⚠️  Ignored (not an existing Clojure file or directory):")
                     (doseq [p dropped] (println "    " p))))

                 (defn run-lint
                   "Returns the clj-kondo exit code (0 clean, 2 warnings, 3 errors)."
                   [args fail-level]
                   (let [{:keys [paths dropped]} (resolve-paths args)]
                     (report-dropped dropped)
                     (if (empty? paths)
                       (do (println "❌ Nothing to lint — no argument resolved to a lintable path.")
                           1)
                       (:exit (apply process/shell
                                     {:dir project-dir :continue true}
                                     "clj-kondo" "--fail-level" fail-level "--lint"
                                     paths)))))

                 (defn run-cljfmt
                   "cmd is \"check\" or \"fix\". Returns the cljfmt exit code."
                   [cmd args]
                   (let [{:keys [paths dropped]} (resolve-paths args)]
                     (report-dropped dropped)
                     (if (empty? paths)
                       (do (println "❌ Nothing to format — no argument resolved to a formattable path.")
                           1)
                       (let [exit (:exit (apply process/shell
                                                {:dir project-dir :continue true}
                                                "cljfmt" cmd paths))]
                         (when (and (= "check" cmd) (not (zero? exit)))
                           (println)
                           (println "Fix with:  cd webapp && bb fmt"))
                         exit))))

                 (defn changed-files
                   "Clojure files under webapp/ changed against the merge-base
                    with LINT_BASE (default origin/master). Deleted files are
                    excluded. Falls back to comparing against HEAD when the
                    base ref cannot be resolved (shallow clone, no remote)."
                   []
                   (let [base    (or (System/getenv "LINT_BASE") "origin/master")
                         base-mb (-> (process/shell {:dir project-dir :out :string
                                                     :err :string :continue true}
                                                    "git" "merge-base" "HEAD" base)
                                     :out str/trim)
                         ref     (if (str/blank? base-mb) "HEAD" base-mb)]
                     (when (str/blank? base-mb)
                       (println (str "⚠️  Could not resolve " base
                                     " — comparing against the working tree only.")))
                     (->> (process/shell {:dir project-dir :out :string :continue true}
                                         "git" "diff" "--name-only" "--diff-filter=d" ref)
                          :out
                          str/split-lines
                          (remove str/blank?)))))

         cljs-watch {:task (shell "npm run watch")}
         bundle-size-check
         {:doc "Check release module sizes against the :app gzip budget (CI guard, see docs/wip/bundle-splitting.md)"
          :task
          (let [;; Gzip budget (KB) for the always-loaded :app module. Code
                ;; splitting's failure mode is silent: one wrong static require
                ;; hoists a lazy namespace into :app with no compile error and
                ;; no dev-time symptom. If this check fails, run
                ;; `npm run build-report` and see what moved into :app; bump
                ;; the budget only for intentional base-module growth.
                ;; Headroom over the current size is deliberately ~20 KB:
                ;; accidental hoists are whole-module-sized (the smallest
                ;; module is ~11 KB gzip, most 30+), so they still trip this.
                app-budget-kb 815
                manifest-path (get-in deploy-config [:paths :frontend-manifest])
                dir (get-in deploy-config [:paths :frontend-compiled-dir])
                _ (when-not (.exists (java.io.File. manifest-path))
                    (println (str "❌ " manifest-path " not found — run `npm run build` first"))
                    (System/exit 1))
                manifest (edn/read-string (slurp manifest-path))
                _ (when (some (fn [m]
                                (some (fn [entry]
                                        (str/starts-with? (str entry) "shadow.cljs.devtools"))
                                      (:entries m)))
                              manifest)
                    (println "❌ manifest.edn is from a dev/watch build — run `npm run build` first")
                    (System/exit 1))
                gzip-size (fn [f]
                            (let [out (java.io.ByteArrayOutputStream.)]
                              (with-open [in (io/input-stream f)
                                          gz (java.util.zip.GZIPOutputStream. out)]
                                (io/copy in gz))
                              (.size out)))
                rows (doall
                       (for [{:keys [module-id output-name]} manifest
                             :let [f (java.io.File. (str dir "/" output-name))]]
                         (do (when-not (.exists f)
                               (println (str "❌ " output-name " referenced by manifest.edn but missing"))
                               (System/exit 1))
                             {:module module-id
                              :raw (.length f)
                              :gzip (gzip-size f)})))
                kb (fn [n] (format "%6.0f" (/ n 1000.0)))]
            (println "Module sizes:")
            (doseq [{:keys [module raw gzip]} (sort-by :gzip > rows)]
              (println (format "  %-12s %s KB raw %s KB gzip" (name module) (kb raw) (kb gzip))))
            (let [app-gzip (or (:gzip (first (filter (fn [row] (= :app (:module row))) rows)))
                               (do (println "❌ no :app module in manifest.edn")
                                   (System/exit 1)))]
              (if (> app-gzip (* app-budget-kb 1000))
                (do (println (format "\n❌ :app is %.0f KB gzip, over the %d KB budget."
                                     (/ app-gzip 1000.0) app-budget-kb))
                    (println "   Likely silent hoisting — run `npm run build-report` and check what moved into :app.")
                    (println "   If the base-module growth is intentional, bump app-budget-kb in bb.edn.")
                    (System/exit 1))
                (println (format "\n✅ :app %.0f KB gzip is within the %d KB budget"
                                 (/ app-gzip 1000.0) app-budget-kb)))))}
         ;; === LINT & FORMAT TASKS ===
         ;; All of these accept optional file arguments and otherwise cover
         ;; src, test, dev, build.clj and scripts. See the :init block above
         ;; for why the working directory is pinned.

         lint {:doc "clj-kondo over all sources, or the files given as arguments. Fails on errors."
               :task (System/exit (run-lint *command-line-args* "error"))}

         lint-strict {:doc "As `lint`, but warnings fail too."
                      :task (System/exit (run-lint *command-line-args* "warning"))}

         lint-changed {:doc "clj-kondo (errors fail) on files changed vs LINT_BASE, default origin/master"
                       ;; An empty changed-file set is a legitimate no-op here,
                       ;; unlike explicitly passed arguments that resolve to
                       ;; nothing — so this exits 0 rather than going through
                       ;; run-lint's "nothing resolved" failure path. It must be
                       ;; caught BEFORE resolve-paths, whose empty-args case
                       ;; means "no arguments given" and falls back to linting
                       ;; everything.
                       :task (let [changed (changed-files)
                                   {:keys [paths]} (when (seq changed)
                                                     (resolve-paths changed))]
                               (if (empty? paths)
                                 (println "No changed Clojure files — nothing to lint.")
                                 (do (println (str "Linting " (count paths) " changed file(s):"))
                                     (doseq [p paths] (println "  " p))
                                     (System/exit (run-lint paths "error")))))}

         fmt {:doc "Format with cljfmt (all sources, or the files given as arguments)"
              :task (System/exit (run-cljfmt "fix" *command-line-args*))}

         fmt-check {:doc "Check formatting without writing (all sources, or given files)"
                    :task (System/exit (run-cljfmt "check" *command-line-args*))}

         check {:doc "What CI runs: fmt-check + lint-strict (warnings fail)"
                :task (let [fmt   (run-cljfmt "check" nil)
                            kondo (run-lint nil "warning")]
                        (System/exit (max fmt kondo)))}

         cljfmt {:doc "Deprecated alias for `fmt` (kept for muscle memory)"
                 :task (System/exit (run-cljfmt "fix" *command-line-args*))}

         ;; Linting the whole dependency classpath always reports findings in
         ;; library sources, so clj-kondo exits non-zero here. That is expected —
         ;; we only want the --copy-configs side effect, so the exit code is
         ;; deliberately ignored.
         init-lint {:doc "Refresh the vendored clj-kondo configs from the dependency classpath (they are committed; rerun after changing deps)"
                    :task (do (process/shell {:dir project-dir :out :string
                                              :err :string :continue true}
                                             "sh" "-c"
                                             "clj-kondo --copy-configs --lint \"$(clojure -A:dev -Spath)\"")
                              (println "clj-kondo configs refreshed under .clj-kondo/"))}

         clean-ns {:doc "Remove unused requires via clojure-lsp, taking files as arguments (needs whole-project analysis, so this one stays on clojure-lsp)"
                   :task (let [files *command-line-args*]
                           (if (seq files)
                             (shell (str "clojure-lsp clean-ns --filenames=" (str/join ":" files)))
                             (do (println "Usage: bb clean-ns <file> [<file> ...]")
                                 (System/exit 1))))}

         ;; === DEPLOYMENT (break-glass only) ===
         ;;
         ;; The normal deploy doors are GitHub Actions: the `lipas-dev` PR
         ;; label for dev and the manually dispatched "Deploy to lipas-prod"
         ;; workflow for prod (see docs/ops.md). This task is the fallback for
         ;; when GitHub or a self-hosted runner is down. It builds the LOCAL
         ;; WORKING TREE and installs it over ssh with the same
         ;; scripts/deploy/install.sh the workflows use. The server-side
         ;; /var/lipas checkout is left untouched (no --sha) — only the
         ;; artifacts change.
         deploy {:doc "BREAK-GLASS: build the local working tree and deploy it to <dev|prod> over ssh"
                 :task (let [[env] *command-line-args*
                             host (get-in deploy-config [:hosts (keyword env)])
                             _ (when-not host
                                 (println "❌ Usage: bb deploy <dev|prod>")
                                 (System/exit 1))
                             describe (-> (shell {:out :string} "git describe --always --dirty")
                                          :out
                                          str/trim)]
                         (println (str "⚠️  Break-glass deploy of the LOCAL WORKING TREE (" describe ") to " env))
                         (println "🏗️  Building backend uberjar...")
                         (shell "bb uberjar")
                         (println "🏗️  Building frontend release bundle...")
                         (shell "npm run build")
                         ;; Archive order is load-bearing: bundles before
                         ;; index.html — see scripts/deploy/install.sh.
                         (println "📦 Packaging frontend bundle...")
                         (shell "tar -czf target/frontend-public.tar.gz -C resources/public js/compiled index.html")
                         (println (str "📦 Uploading artifacts to " host "..."))
                         (shell (str "ssh " host " mkdir -p /tmp/lipas-release"))
                         (shell (str "scp target/backend.jar target/frontend-public.tar.gz ../scripts/deploy/install.sh " host ":/tmp/lipas-release/"))
                         (println (str "🔄 Installing on " host "..."))
                         (shell "ssh" host "sudo" "bash" "/tmp/lipas-release/install.sh"
                                "--artifacts" "/tmp/lipas-release"
                                "--door" "laptop"
                                "--label" describe)
                         (println (str "✅ Break-glass deployment to " env " completed"))
                         (println (str "🌐 " (get-in deploy-config [:urls (keyword env)]))))}

         ;; Database Migration Tasks
         db-migrate {:doc "Run all pending database migrations"
                     :task (shell "clojure -M:migrate migrate")}

         db-status {:doc "Show database migration status"
                    :task (shell "clojure -M:migrate status")}

         db-rollback {:doc "Rollback the last database migration"
                      :task (shell "clojure -M:migrate rollback")}

         db-reset {:doc "Reset database - rollback all migrations then migrate up"
                   :task (do (println "⚠️  WARNING: This will reset the entire database!")
                             (print "Are you sure? (y/N): ")
                             (flush)
                             (let [response (read-line)]
                               (if (= (str/lower-case response) "y")
                                 (shell "clojure -M:migrate reset")
                                 (println "Database reset cancelled."))))}

         db-create {:doc "Create a new migration file with given name"
                    :task (let [migration-name (first *command-line-args*)]
                            (if migration-name
                              (shell "clojure -M:migrate create" migration-name)
                              (do (println "Usage: bb db-create <migration-name>")
                                  (println "Example: bb db-create add-user-table"))))}

         db-up {:doc "Migrate up to a specific migration ID"
                :task (let [migration-id (first *command-line-args*)]
                        (if migration-id
                          (shell "clojure -M:migrate up" migration-id)
                          (do (println "Usage: bb db-up <migration-id>")
                              (println "Example: bb db-up 20240101123456"))))}

         db-down {:doc "Migrate down a specific migration ID"
                  :task (let [migration-id (first *command-line-args*)]
                          (if migration-id
                            (shell "clojure -M:migrate down" migration-id)
                            (do (println "Usage: bb db-down <migration-id>")
                                (println "Example: bb db-down 20240101123456"))))}

         ;; Build Tasks
         uberjar {:doc "Build uberjar using tools.build"
                  :override-builtin true
                  :task (shell "clojure -T:build uber")}

         build-clean {:doc "Clean build artifacts"
                      :task (shell "clojure -T:build clean")}

         jar {:doc "Build library jar"
              :task (shell "clojure -T:build jar")}

         verify-uberjar {:doc "Verify uberjar was built correctly"
                         :task (do (let [jar-file (get-in deploy-config [:paths :backend-jar])]
                                     (if (.exists (java.io.File. jar-file))
                                       (do (println "✅ Uberjar exists:" jar-file)
                                           (let [size (-> (java.io.File. jar-file) .length (/ 1024 1024) int)]
                                             (println (str "📊 Size: " size "MB")))
                                           (println "📋 Testing manifest...")
                                           (shell "jar" "-tf" jar-file "| grep -q META-INF/MANIFEST.MF")
                                           (println "✅ Manifest found")
                                           (println "🔍 Testing main class...")
                                           (shell "jar" "-tf" jar-file "| grep -q lipas/aot.class")
                                           (println "✅ Main class compiled and present")
                                           (println "🎯 Uberjar verification complete!"))
                                       (println "❌ Uberjar not found. Run 'bb uberjar' first."))))}

         ;; Docker Compose Tasks
         ;; Test Tasks (using Kaocha - captures output, only shows on failure)
         test {:doc "Run all tests"
               :task (shell "clojure -M:dev:test")}

         test-specific {:doc "Run one or more test namespaces"
                        :task (let [namespaces *command-line-args*]
                                (if (seq namespaces)
                                  (apply shell "clojure" "-M:dev:test"
                                         (mapcat (fn [ns] ["--focus" ns]) namespaces))
                                  (do (println "Usage: bb test-specific <ns> [<ns> ...]")
                                      (println "Example: bb test-specific lipas.backend.gis-test")
                                      (println "Example: bb test-specific lipas.backend.gis-test lipas.backend.org-test"))))}

         test-ns {:doc "Alias to test-specific"
                  :task (run 'test-specific)}

         test-var {:doc "Run one or more test vars"
                   :task (let [vars *command-line-args*]
                           (if (seq vars)
                             (apply shell "clojure" "-M:dev:test"
                                    (mapcat (fn [v] ["--focus" v]) vars))
                             (do (println "Usage: bb test-var <var> [<var> ...]")
                                 (println "Example: bb test-var lipas.backend.gis-test/centroid-test")
                                 (println "Example: bb test-var lipas.backend.gis-test/centroid-test lipas.roles-test/admin-test"))))}

         i18n-unused {:doc "Find unused translation keys. Use --remove to delete them, --dry-run to preview."
                      :task (apply shell "bb" "scripts/unused_translations.bb" *command-line-args*)}

         test-watch {:doc "Run tests in watch mode (re-runs on file changes)"
                     :task (shell "clojure" "-M:dev:test" "--watch")}

         test-verbose {:doc "Run all tests with full output (no capture)"
                       :task (shell "clojure" "-M:dev:test" "--no-capture-output")}

         geoserver-snapshot
         {:doc "Download Shape-Zip snapshots of lipas_kaikki_{pisteet,reitit,alueet} from prod Geoserver in EPSG:3067 into local-scrap/<yyyy-mm-dd>-otos/"
          :requires ([babashka.fs :as fs]
                     [babashka.http-client :as http]
                     [clojure.java.io :as io])
          :task (let [layers   ["lipas_kaikki_pisteet"
                                "lipas_kaikki_reitit"
                                "lipas_kaikki_alueet"]
                      date-str (str (java.time.LocalDate/now))
                      out-dir  (str "local-scrap/" date-str "-otos")]
                  (fs/create-dirs out-dir)
                  (println (str "📦 Snapshot directory: " out-dir))
                  (doseq [layer layers]
                    (let [url      (str "https://lipas.fi/geoserver/wfs"
                                        "?service=WFS"
                                        "&version=2.0.0"
                                        "&request=GetFeature"
                                        "&typeName=lipas:" layer
                                        "&outputFormat=SHAPE-ZIP"
                                        "&srsName=EPSG:3067"
                                        "&format_options=filename:" layer)
                          out-file (str out-dir "/" layer ".zip")]
                      (println (str "⬇️  " layer))
                      (with-open [in  (:body (http/get url {:as :stream}))
                                  out (io/output-stream out-file)]
                        (io/copy in out))
                      (let [size-mb (-> (fs/size out-file) (/ 1024.0 1024.0))]
                        (println (format "✅ %s (%.2f MB)" out-file size-mb)))))
                  (println "🎉 Done"))}}}

{:skip-comments true
 :lint-as
 {reagent.core/with-let clojure.core/let}

 :linters
 {:unsorted-required-namespaces {:level :warning
                                 :sort :case-sensitive}

  :consistent-alias {:aliases {clojure.string str
                               re-frame.core rf
                               reagent.core r}}

  :discouraged-namespace {goog.object {:message "Prefer JS interop over goog.object"}}

  ;; Vars that genuinely exist at runtime but are generated by a macro
  ;; clj-kondo cannot expand. These are suppressions of false positives, not
  ;; of real problems — each entry names a namespace whose public vars are
  ;; defined by a code-generating call rather than by `def`.
  :unresolved-var
  {:exclude [;; (hugsql/def-db-fns "sql/….sql") defines one var per named
             ;; query in the SQL file.
             lipas.backend.db.city
             lipas.backend.db.loi
             lipas.backend.db.reminder
             lipas.backend.db.sports-site
             lipas.backend.db.subsidy
             lipas.backend.db.user
             lipas.backend.db.versioned-data
             lipas.jobs.db

             ;; (utils/deftranslations "fi") defines `translations` by reading
             ;; the EDN resource tree at macroexpansion time.
             lipas.i18n.en
             lipas.i18n.fi
             lipas.i18n.se]}}

 ;; lipas.ui.lazy is the code-splitting registry. Every
 ;; (shadow.lazy/loadable some.ns/var) names a namespace it must NOT require:
 ;; a static require would hoist that whole lazy module into the always-loaded
 ;; :app bundle, which is silent at compile time and only shows up as a bundle
 ;; size regression (see `bb bundle-size-check` and
 ;; docs/wip/bundle-splitting.md). Unresolved namespaces are therefore expected
 ;; here, and only here.
 :config-in-ns
 {lipas.ui.lazy {:linters {:unresolved-namespace {:level :off}}}}}

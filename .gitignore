/.env*
!/.env.sample.sh
.DS_Store
.nrepl-port
*.backup
test_routes.clj
/certs/*
!/certs/README.md
*.jar
/geoserver/*
!/geoserver/README.md
/osrm/*
!/osrm/README.md
!/osrm/update-data.sh
.calva
.cpcache

random-files/

!webapp/dev/repl.clj
webapp/.nrepl-port
webapp/*.log
webapp/target
webapp/*-init.clj
webapp/resources/public/js/compiled
webapp/resources/public/index.html
webapp/resources/public/google*.html
webapp/.cljs_rhino_repl
webapp/.clj-kondo/.cache
# The vendored per-library configs under webapp/.clj-kondo/<lib>/ ARE tracked.
# They decide how macros are linted, so leaving them out made CI lint against a
# different config set than any developer machine. Refresh with `bb init-lint`
# after changing deps.
webapp/node_modules
webapp/dist
webapp/.lsp/.cache
webapp/.lsp/*.db
webapp/out
webapp/.shadow-cljs
webapp/.user.edn
webapp/.nrepl.edn
webapp/.dir-locals.el
webapp/logs/
webapp/test_routes.clj
webapp/local-scrap
webapp/.eca/

# IDE and development files
.claude/*
!.claude/skills/
# settings.json is the shared, committed Claude Code config (hooks live there).
# settings.local.json stays ignored — that is the per-developer override.
!.claude/settings.json
.git-rewrite/
data/